{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "universal-code",
  "compatibility_date": "2026-06-22",
  "observability": {
    "enabled": true
  },
  "main": "@tanstack/react-start/server-entry",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "UNIVERSAL_STORE_BACKEND",
        "class_name": "UniversalStore",
        "script_name": "universal-store"
      }
    ]
  },
  "services": [
    {
      "binding": "UNIVERSAL_STORE",
      "service": "universal-store"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client/"
  }
}